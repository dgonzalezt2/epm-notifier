# Token del bot (de @BotFather)
TELEGRAM_BOT_TOKEN=123456789:REEMPLAZA_CON_TU_TOKEN
# Tu chat id (o el del canal, p. ej. -1001234567890). Obtenerlo: node epm-notifier.mjs --get-chat-id
TELEGRAM_CHAT_ID=
# Opcional: palabras clave separadas por coma (filtra por título/ubicación; sin tildes ni mayúsculas)
KEYWORDS=
# Opcional: archivo de estado
STATE_FILE=./seen.json
# Opcional: maximo de suscriptores publicos (por defecto 500)
MAX_SUBS=500
# Webhook de Telegram (respuesta rápida con Cloudflare Worker). Ver README.
# URL del Worker, p. ej. https://epm-notifier-webhook.<tu-subdominio>.workers.dev
WEBHOOK_URL=
# Secret aleatorio (32-256 caracteres [A-Za-z0-9_-]); el mismo valor va al Worker. Genéralo con: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
